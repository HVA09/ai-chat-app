# Production template. Copy to .env.production on the server and fill every secret.
# NEVER commit the real .env.production file.

APP_NAME=AI Backend
ENVIRONMENT=production
DEBUG=false

POSTGRES_USER=ai_backend
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
POSTGRES_DB=ai_backend
DATABASE_URL=postgresql://ai_backend:REPLACE_WITH_LONG_RANDOM_PASSWORD@db:5432/ai_backend

JWT_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
TOTP_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
TOTP_ISSUER_NAME=AI Backend

AI_API_KEY=REPLACE_WITH_PROVIDER_KEY
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_PROVIDER=openai
DAILY_AI_REQUEST_LIMIT=20
MAX_AI_OUTPUT_TOKENS=1200

INITIAL_ADMIN_EMAIL=admin@example.com
FRONTEND_URL=https://your-frontend.example.com

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM_EMAIL=noreply@your-domain.example
SMTP_USE_TLS=true

MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=10
MAX_FILES_PER_USER=100
MAX_STORAGE_PER_USER_MB=500

PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=REPLACE_WITH_STRIPE_SECRET
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_STRIPE_WEBHOOK_SECRET
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=https://api-m.paypal.com
BILLING_SUCCESS_PATH=/billing/success
BILLING_CANCEL_PATH=/billing/cancel

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1
CACHE_TTL_SECONDS=60

# Replace with the exact trusted frontend origin(s).
CORS_ORIGINS=["https://your-frontend.example.com"]

# Set this to the image built and published by the production CI/CD workflow.
BACKEND_IMAGE=ghcr.io/hva09/ai-chat-app-backend:latest

CLINICALTRIALS_BASE_URL=https://clinicaltrials.gov/api/v2
RXNORM_BASE_URL=https://rxnav.nlm.nih.gov/REST
PUBMED_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
OPENFDA_BASE_URL=https://api.fda.gov
NPI_REGISTRY_BASE_URL=https://npiregistry.cms.hhs.gov/api
MEDICARE_CARE_COMPARE_BASE_URL=https://data.cms.gov
DAILYMED_BASE_URL=https://dailymed.nlm.nih.gov/dailymed/services/v2
CMS_OPEN_DATA_BASE_URL=https://data.cms.gov/provider-data/api/1
CMS_COVERAGE_BASE_URL=https://api.coverage.cms.gov
